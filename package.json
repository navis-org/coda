{
  "name": "coda",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Connectome Data Analysis \u2014 node-graph analysis pipelines for connectomic data",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "export:check": "vitest run src/export && python3 scripts/check-export.py && Rscript scripts/check-export.R",
    "export:golden": "UPDATE_GOLDEN=1 vitest run src/export",
    "probe:nblast": "node scripts/probe-nblast.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "probe:roimeshes": "node scripts/probe-roimeshes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-border": "^3.0.0",
    "@xyflow/react": "^12.4.4",
    "draco3d": "^1.5.7",
    "elkjs": "^0.12.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sigma": "^3.0.3",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.27.0",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
